@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title AdScale: целевая архитектура через год (C4 Container)

Person(advertiser, "Рекламодатель", "Управляет кампаниями, бюджетами и отчётами")
Person_Ext(user, "Пользователь сайта или приложения", "Смотрит рекламу и переходит по ней")
System_Ext(dsp, "DSP-партнёры", "Отправляют запросы ставок и уведомления по OpenRTB")
System_Ext(payment, "Платёжный шлюз", "Принимает платежи")

System_Boundary(adscale, "AdScale") {
    Boundary(rtb, "Обработка ставок") {
        Container(edge, "Шлюз RTB", "Go / HTTPS, OpenRTB", "Адаптеры площадок, проверка запросов и времени ответа")
        Container(bidding, "Сервис ставок", "C++ / данные в памяти", "Подбор рекламы и аукцион по локальным копиям кампаний и лимитов")
    }
    Boundary(management, "Управление") {
        Container(dashboard, "Рекламный кабинет", "Node.js / JavaScript", "Интерфейс рекламодателя")
        Container(api, "Шлюз управления", "API Gateway / HTTPS", "Проверка доступа и маршрутизация запросов кабинета")
        Container(campaign, "Сервис кампаний", "Go", "Кампании, ставки, правила подбора и рекламные материалы")
        Container(finance, "Финансовый сервис", "Go", "Балансы, счета, платежи, списания и резервирование лимитов")
        ContainerDb(campaignDb, "База кампаний", "PostgreSQL", "Кампании и сообщения для публикации; владелец: сервис кампаний")
        ContainerDb(financeDb, "База финансов", "PostgreSQL", "Денежные операции, лимиты и сообщения; владелец: финансовый сервис")
    }
    Boundary(events, "Выдача, события и отчёты") {
        Container(delivery, "Сервис выдачи", "Node.js", "Выдаёт подготовленные рекламные материалы")
        ContainerDb(assets, "Рекламные материалы", "Объектное хранилище", "Файлы; записывает сервис кампаний, читает сервис выдачи")
        Container(collector, "Сборщик событий", "Go / HTTPS", "Принимает показы, клики и уведомления; подтверждает после записи брокером")
        ContainerQueue(kafka, "Брокер событий", "Kafka", "События, изменения кампаний, лимиты и команды списания")
        Container(metering, "Сервис учёта событий", "Go", "Убирает повторы, определяет основание оплаты, создаёт команды списания")
        ContainerDb(meteringDb, "База учёта событий", "PostgreSQL", "Учтённые события и сообщения; владелец: сервис учёта событий")
        Container(analytics, "Сервис аналитики", "Python / API и обработчики", "Получает события и строит отчёты независимо от ставок")
        ContainerDb(olap, "База аналитики", "ClickHouse", "События и итоговые показатели; владелец: сервис аналитики")
        Container(projector, "Сервис обновления кеша", "Go", "Готовит копии кампаний и лимитов из событий")
        ContainerDb(cache, "Кеш кампаний и лимитов", "Redis", "Восстанавливаемые копии с версиями и сроком действия")
    }
}

Rel(dsp, edge, "Запрос ставки / ответ", "HTTPS / OpenRTB")
Rel(edge, bidding, "Расчёт ставки / результат", "RPC, синхронно")
Rel(advertiser, dashboard, "Управляет рекламой", "HTTPS")
Rel(dashboard, api, "Команды и запросы отчётов", "HTTPS / JSON")
Rel(api, campaign, "Управление кампаниями", "HTTP / JSON")
Rel(api, finance, "Управление бюджетом", "HTTP / JSON")
Rel(api, analytics, "Запрос отчёта", "HTTP / JSON")
Rel(campaign, campaignDb, "Читает и записывает", "SQL")
Rel(finance, financeDb, "Денежные транзакции и лимиты", "SQL")
Rel(finance, payment, "Пополнение / результат платежа", "HTTPS")
Rel(campaign, assets, "Записывает материалы", "HTTPS")
Rel(user, delivery, "Получает рекламу", "HTTPS")
Rel(delivery, assets, "Читает материалы", "HTTPS")
Rel(user, collector, "Показы и клики", "HTTPS")
Rel(dsp, collector, "Уведомления о результате и оплате", "HTTPS")
Rel(collector, kafka, "Публикует события", "Kafka, асинхронный поток")
Rel(kafka, metering, "Доставляет события", "Kafka, асинхронно")
Rel(metering, meteringDb, "Проверяет повторы, сохраняет учёт и команды", "SQL")
Rel(metering, kafka, "Публикует команды списания из БД", "Kafka, асинхронно")
Rel(kafka, finance, "Доставляет команды списания", "Kafka, асинхронно")
Rel(kafka, analytics, "Доставляет события", "Kafka, асинхронно")
Rel(analytics, olap, "Записывает события и читает отчёты", "SQL")
Rel(campaign, kafka, "Публикует изменения из БД", "Kafka, асинхронно")
Rel(finance, kafka, "Публикует выделенные лимиты из БД", "Kafka, асинхронно")
Rel(kafka, projector, "Доставляет кампании и лимиты", "Kafka, асинхронно")
Rel(projector, cache, "Обновляет копии", "Redis protocol")
Rel(bidding, cache, "Читает обновления в фоне", "Redis protocol, вне расчёта ставки")

legend bottom
  |= Цели через год |
  | 50 000 запросов/с; доступность 99,9%; несколько регионов |
  | Логическая схема: копии сервисов и резервные узлы не показаны |
  | Новые технологии предложены и требуют проверки нагрузкой |
  |= Обозначения |
  | Синий: приложение или хранилище AdScale |
  | Тёмно-синий: рекламодатель; серый: внешний участник |
  | Стрелки: вызов либо направление передачи событий |
  | PostgreSQL каждого сервиса доступна только владельцу |
endlegend
@enduml
