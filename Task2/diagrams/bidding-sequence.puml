@startuml
title AdScale: расчёт ставки
hide footbox
autonumber
participant "DSP-партнёр" as dsp
participant "Шлюз RTB\nEnvoy + адаптер" as edge
participant "Сервис ставок" as bid
collections "Данные в памяти" as local

dsp -> edge : POST /openrtb2/auction
edge -> edge : Проверка доступа, формата,\nнагрузки и оставшегося времени

alt Запрос отклонён на входе
    edge --> dsp : 400 / 403 / 429
else Размыкатель открыт или нет готовых экземпляров
    edge --> dsp : 503, быстрый технический отказ
else Можно выполнить расчёт
    edge -> bid : gRPC Bid, срок завершения
    bid -> local : Прочитать кампании и действующие лимиты
    local --> bid : Локальная копия
    bid -> bid : Подобрать материал и рассчитать цену
    alt Есть кандидат, лимит и время
        bid -> local : Атомарно зарезервировать сумму
        local --> bid : Резерв создан
        bid --> edge : Ставка, материал и идентификатор
        edge --> dsp : 200, ответ OpenRTB
    else Нет кандидата, действительного лимита или времени
        bid --> edge : Отказ от участия с причиной
        edge --> dsp : 204, без тела
    else Техническая ошибка или превышено время вызова
        edge -> bid : Отмена незавершённого вызова
        edge --> dsp : 503 / 504
    end
end

note over edge, bid
  Уже начатый расчёт не отправляется повторно.
  Обновления данных идут в фоне.
  После отмены неизвестный резерв удерживается до сверки.
end note
@enduml
