@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title AdScale: компоненты сервиса ставок (C4 Component)

System_Ext(dsp, "DSP-партнёр", "Отправляет запрос ставки и получает предложение")
Container(edge, "Шлюз RTB", "Envoy + адаптер Go", "Проверка доступа, ограничение нагрузки, OpenRTB и контроль времени")

Container_Boundary(bidding, "Сервис ставок: одно приложение на C++") {
    Component(api, "Обработчик запроса", "gRPC", "Проверяет запрос и оставшееся время, возвращает результат")
    Component(auction, "Подбор и расчёт", "C++", "Выбирает кампанию и материал, рассчитывает цену")
    Component(quota, "Контроль бюджета", "C++", "Атомарно проверяет и уменьшает выделенный лимит")
    Component(local, "Локальные данные", "Память процесса", "Кампании, материалы, лимиты и резервы ставок")
    Component(refresh, "Обновление данных", "Фоновый обработчик", "Проверяет версии и заменяет локальную копию")
}

Container(campaign, "Сервис кампаний", "REST / PostgreSQL", "Владелец кампаний и рекламных материалов")
Container(finance, "Финансовый сервис", "Go / PostgreSQL", "Владелец бюджета, выделяет лимиты")
ContainerQueue(kafka, "Брокер событий", "Kafka", "Изменения кампаний и выделенных лимитов")
Container(projector, "Сервис обновления кеша", "Go", "Готовит данные для быстрого чтения")
ContainerDb(redis, "Кеш", "Redis", "Копии данных с версиями и сроками действия")

Rel(dsp, edge, "Запрос / ответ", "HTTPS / OpenRTB")
Rel(edge, api, "Рассчитать ставку", "gRPC, синхронно")
Rel(api, auction, "Передать запрос", "Внутренний вызов")
Rel(auction, local, "Прочитать условия", "Память")
Rel(auction, quota, "Зарезервировать сумму", "Внутренний вызов")
Rel(quota, local, "Проверить и уменьшить остаток", "Атомарно")
Rel(campaign, kafka, "Изменения кампаний", "Асинхронно")
Rel(finance, kafka, "Выделенные лимиты", "Асинхронно")
Rel(kafka, projector, "Доставить изменения", "Kafka")
Rel(projector, redis, "Обновить копии", "Redis protocol")
Rel(refresh, redis, "Прочитать обновления", "Только в фоне")
Rel(refresh, local, "Применить новую версию", "Память")

footer В расчёте ставки нет ожидания PostgreSQL, Redis, Kafka или платежа.
@enduml
